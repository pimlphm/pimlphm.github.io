{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run content:build",
    "dev": "vinext dev",
    "prebuild": "npm run content:build",
    "build": "vinext build",
    "prebuild:github": "npm run content:build",
    "build:github": "vite build --config vite.github.config.ts",
    "preview:github": "vite preview --config vite.github.config.ts",
    "sync:scholar": "node scripts/sync-scholar.mjs",
    "sync:scholar:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-scholar-local.ps1",
    "check:scholar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-scholar-local.ps1 -Check",
    "test:scholar-sync": "node --test scripts/sync-scholar.test.mjs",
    "test:bilingual": "node --test scripts/bilingual.test.mjs",
    "test:content": "node --test scripts/compile-content.test.mjs",
    "content:build": "node scripts/compile-content.mjs",
    "content:check": "node scripts/compile-content.mjs --check",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern github-dist"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
